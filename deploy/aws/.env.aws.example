# AWS deployment settings for Lost N Found.
# Copy this file to deploy/aws/.env.aws, fill in the values, then run:
#   bash deploy/aws/deploy.sh
#
# deploy/aws/.env.aws is git-ignored and is NOT copied into the container image.
# Values marked secret go to Secrets Manager and are injected at runtime.

# --- AWS target -------------------------------------------------------------
AWS_REGION=us-east-1
SERVICE_NAME=lost-n-found
ECR_REPOSITORY=lost-n-found
CLUSTER=default

# Container port the app listens on (server.js reads PORT; 3000 is the default).
CONTAINER_PORT=3000

# Fargate sizing: CPU in task units (256 = 0.25 vCPU), MEMORY in MiB.
CPU=512
MEMORY=1024

# Keep MIN_TASKS/MAX_TASKS at 1 for predictable cost and to avoid two tasks
# seeding an empty database at the same moment. Raise MAX_TASKS later if needed.
MIN_TASKS=1
MAX_TASKS=1

# --- application ------------------------------------------------------------
NODE_ENV=production

# Public origin of the service. Leave empty on the first deploy; the script
# prints the service URL. Set it afterwards and deploy again so Google OAuth
# always uses the same redirect URI.
APP_ORIGIN=

CAMPUS_NAME=RVU Mysore

# --- Google sign-in ---------------------------------------------------------
# OAuth client (Web application). Register the redirect URI printed by the
# deploy script: https://<service-url>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_DOMAIN=mys.rvu.edu.in

# --- sessions (secret) ------------------------------------------------------
# Required. Signs session cookies across restarts and multiple tasks.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- persistence: Amazon RDS Postgres (secret) ------------------------------
# Full connection string, including the password. Apply the schema first:
#   psql "$RDS_DATABASE_URL" -f deploy/aws/rds-schema.sql
RDS_DATABASE_URL=

# Table prefix; must match the schema file (default lnf_).
RDS_TABLE_PREFIX=lnf_

# --- photo storage: Amazon S3 ----------------------------------------------
# Leave S3_BUCKET empty to get lnf-photos-<account-id>. The script creates the
# bucket, allows public reads of objects, and grants the task role write access.
S3_BUCKET=
S3_REGION=us-east-1
