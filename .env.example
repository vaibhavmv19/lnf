# Copy to .env and fill in the values. .env is committed in this private repo.

# --- Supabase persistence (optional) ---------------------------------------
# When both of these are set the dataset is loaded from / written to the
# app_state table in your Supabase project (see supabase_schema.sql).
# Use the SERVICE ROLE key: it stays on the server and is never sent to the
# browser. Without these the app uses the local data/db.json file.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Google sign-in ---------------------------------------------------------
# OAuth client from Google Cloud Console -> APIs & Services -> Credentials.
# The client must accept this redirect URI:
#   http://localhost:3000/api/auth/google/callback
# A "Desktop app" client accepts any loopback redirect without registration;
# a "Web application" client needs it added under Authorised redirect URIs.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Workspace domain allowed to sign in. Accounts are checked against the ID
# token's `hd` claim as well as the email suffix.
GOOGLE_ALLOWED_DOMAIN=mys.rvu.edu.in

# Public origin for deployed hosting (required for OAuth callbacks on a real domain)
# APP_ORIGIN=https://foundnlost-rvu.vercel.app

# Stable secret for signed sessions on stateless hosts (Vercel/Lambda).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# --- Supabase persistence (optional but recommended on Vercel) ---
# Create a project, run supabase_schema.sql, then paste the service role key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key
# SUPABASE_PHOTO_BUCKET=lnf-photos
